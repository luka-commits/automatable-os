# Copy this file to context/config.yaml and fill it in — the setup skill does
# this for you interactively, but you can also edit it by hand.
#
# Flat key: value pairs only (no nesting) — the dashboard renderer parses this
# with a small hand-rolled reader, not a YAML library, to keep the repo
# dependency-free.

name: "Your Name"

# "de" or "en" — controls the whole dashboard (labels, dates) AND the chat
# sentences the "copy" buttons produce, since those get pasted into your own
# Claude Code chat and should match the language you work in.
language: "en"

# Your Upwork account/org identifier, needed for the screener's find_jobs
# calls. The setup skill fetches this for you automatically via the Upwork
# MCP connection — you shouldn't need to find it yourself.
upwork_org_uid: ""

# Your public Upwork profile. The pitch page's closing button points here, so
# without it the page ends on the paragraph and no button — which is the right
# failure, but a weaker page. Setup fills this in from your account.
upwork_profile_url: ""

# Optional, all three. They appear on a pitch page only if set: the portfolio
# under the work samples, the channel under the videos, the website in the
# footer. An unset one is left out rather than linked dead.
portfolio_url: ""
youtube_url: ""
website_url: ""

# Optional. Your own Slack user ID (for DM notifications on strong matches).
# Leave empty to skip Slack entirely — the screener still logs every
# candidate to the dashboard either way, Slack is just a push notification.
slack_channel_id: ""

# How many proposals you aim to send per working day. The dashboard's tracker
# counts against this, and it is the one number the whole pipeline exists to
# move. Pick something you will actually hit — a goal you miss daily stops
# being a goal after a week.
daily_proposal_goal: 5

# The platforms you actually build on, comma-separated. Two jobs: it sharpens
# the screener's niche fit, and it lets a skill tell you *which* credential is
# missing instead of failing vaguely. Free text, use the names clients use.
# Example: "gohighlevel, n8n, make, zapier"
tools: ""

# API keys are NOT stored here and never in this repo. They live in
# ~/.config/credentials.env with chmod 600, one KEY=value per line, and every
# skill reads them from there. .gitignore already blocks credentials.env, .env
# and *.key — but the habit is what protects you, not the file.
# A skill that needs a key you have not set says which one and stops. It does
# not guess, and it does not carry on with half the picture.
